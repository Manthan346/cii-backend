    "_exporter_id": "user"
  },
  "item": [
    {
      "name": "Download Enrollment Report - All Centers",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{superadmin_access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/superadmin/reports/enrollment?from_date=2025-01-01&to_date=2025-12-31",
          "host": ["{{base_url}}"],
          "path": ["api", "superadmin", "reports", "enrollment"],
          "query": [
            {
              "key": "from_date",
              "value": "2025-01-01",
              "description": "Start date in YYYY-MM-DD format (required)"
            },
            {
              "key": "to_date",
              "value": "2025-12-31",
              "description": "End date in YYYY-MM-DD format (required)"
            }
          ]
        },
        "description": "Download enrollment report for ALL centers within date range"
      },
      "response": []
    },
