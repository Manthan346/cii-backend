generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model candidates_details {
  candidate_id          Int                     @id @default(autoincrement())
  candidate_first_name  String                  @db.VarChar(100)
  contact_number        String                  @unique @db.VarChar(10)
  gender                String?                 @db.VarChar(10)
  date_of_birth         DateTime?               @db.Date
  education             String?                 @db.VarChar(100)
  candidate_address     String?
  center_name           String?                 @db.VarChar(100)
  enquiry_source        String?                 @db.VarChar(50)
  aadhar_card_no        String?                 @db.VarChar(50)
  pan_card_no           String?                 @db.VarChar(50)
  nearest_station       String?                 @db.VarChar(50)
  pin_code              Int?
  district              String?                 @db.VarChar(50)
  state_name            String?                 @db.VarChar(50)
  course_name           String?                 @db.VarChar(100)
  salary                Int?
  batch_no              Int?
  training_start_date   DateTime?               @db.Date
  training_end_date     DateTime?               @db.Date
  job_location          String?                 @db.VarChar(100)
  candidate_status      String?                 @db.VarChar(50)
  verification_status   String?                 @db.VarChar(50)
  blood_group           String?                 @db.VarChar(5)
  category              String?                 @db.VarChar(15)
  candidate_last_name   String?                 @db.VarChar(50)
  guardian_name         String?                 @db.VarChar(50)
  user_id               String?                 @db.Uuid
  created_at            DateTime?               @db.Timestamp(6)
  updated_at            DateTime?               @db.Timestamp(6)
  attendance_records    attendance_records[]
  candidate_assessments candidate_assessments[]
  user_login            user_login?             @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  course_enrollment     course_enrollment[]
}

model staff_details {
  staff_id   Int     @id @default(autoincrement())
  staff_name String  @db.VarChar(100)
  gender     String? @db.VarChar(50)
}

model attendance_records {
  record_id          Int                 @id @default(autoincrement())
  candidate_id       Int?
  batch_id           Int?
  created_at         DateTime?           @db.Timestamp(6)
  updated_at         DateTime?           @db.Timestamp(6)
  is_present         attend_types?
  batch_details      batch_details?      @relation(fields: [batch_id], references: [batch_id], onDelete: NoAction, onUpdate: NoAction)
  candidates_details candidates_details? @relation(fields: [candidate_id], references: [candidate_id], onDelete: NoAction, onUpdate: NoAction)
}

model batch_details {
  batch_id           Int                  @id @default(autoincrement())
  batch_name         String?              @db.VarChar(100)
  batch_desc         String?
  batch_start_date   DateTime?            @db.Date
  batch_end_date     DateTime?            @db.Date
  course_id          Int?
  batch_code         String?              @unique @db.VarChar(255)
  max_candidates     Int?
  created_at         DateTime?            @db.Timestamp(6)
  updated_at         DateTime?            @db.Timestamp(6)
  assessments        assessments[]
  attendance_records attendance_records[]
  course_details     course_details?      @relation(fields: [course_id], references: [course_id], onDelete: NoAction, onUpdate: NoAction)
  course_enrollment  course_enrollment[]
}

model course_details {
  course_id       Int               @id(map: "course_detail_pkey") @default(autoincrement())
  course_name     String?           @db.VarChar(100)
  course_desc     String?
  course_duration String?
  company_id      Int?
  course_type     String?           @db.VarChar(50)
  created_at      DateTime?         @db.Timestamp(6)
  updated_at      DateTime?         @db.Timestamp(6)
  batch_details   batch_details[]
  company         company_details?  @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "course_detail_company_id_fkey")
  enquiry_records enquiry_records[]
}

model course_enrollment {
  enroll_id          Int                 @id @default(autoincrement())
  candidate_id       Int?
  batch_id           Int?
  batch_details      batch_details?      @relation(fields: [batch_id], references: [batch_id], onDelete: NoAction, onUpdate: NoAction)
  candidates_details candidates_details? @relation(fields: [candidate_id], references: [candidate_id], onDelete: NoAction, onUpdate: NoAction)
}

model center_company {
  center_id      Int
  company_id     Int
  created_at     DateTime?       @db.Timestamp(6)
  updated_at     DateTime?       @db.Timestamp(6)
  center_details center_details  @relation(fields: [center_id], references: [center_id], onDelete: NoAction, onUpdate: NoAction)
  company_name   company_details @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([center_id, company_id])
}

model center_details {
  center_id       Int               @id(map: "center_pkey") @default(autoincrement())
  center_name     String?           @unique(map: "center_center_name_key") @db.VarChar(255)
  centre_address  String?
  created_at      DateTime?         @db.Timestamp(6)
  updated_at      DateTime?         @db.Timestamp(6)
  center_company  center_company[]
  enquiry_records enquiry_records[]
  user_login      user_login[]
}

model enquiry_records {
  enquiry_id        Int             @id @default(autoincrement())
  enquiry_name      String?         @db.VarChar(255)
  enquiry_email     String?         @db.VarChar(255)
  enquiry_location  String?         @db.VarChar(255)
  enquiry_phone_no  String?         @db.VarChar(255)
  enquiry_education String?         @db.VarChar(255)
  centre_id         Int?
  course_id         Int?
  center_details    center_details? @relation(fields: [centre_id], references: [center_id], onDelete: NoAction, onUpdate: NoAction)
  course_details    course_details? @relation(fields: [course_id], references: [course_id], onDelete: NoAction, onUpdate: NoAction)
}

model user_login {
  user_id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_email         String               @db.VarChar(255)
  password_hash      String
  user_role          String               @db.VarChar(50)
  center_id          Int?
  candidates_details candidates_details[]
  center_details     center_details?      @relation(fields: [center_id], references: [center_id], onDelete: NoAction, onUpdate: NoAction)
}

model assessments {
  assessment_id         Int                     @id @default(autoincrement())
  assessment_name       String?                 @db.VarChar(250)
  assessment_type       String?                 @db.VarChar(250)
  assessment_desc       String?
  batch_id              Int?
  total_marks           Int?
  created_at            DateTime?               @db.Timestamp(6)
  updated_at            DateTime?               @db.Timestamp(6)
  batch_details         batch_details?          @relation(fields: [batch_id], references: [batch_id], onDelete: NoAction, onUpdate: NoAction)
  candidate_assessments candidate_assessments[]
}

model candidate_assessments {
  ca_id              Int                 @id @default(autoincrement())
  candidate_id       Int?
  assessment_id      Int?
  marks_obtained     Int?
  created_at         DateTime?           @db.Timestamp(6)
  updated_at         DateTime?           @db.Timestamp(6)
  assessments        assessments?        @relation(fields: [assessment_id], references: [assessment_id], onDelete: NoAction, onUpdate: NoAction)
  candidates_details candidates_details? @relation(fields: [candidate_id], references: [candidate_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([candidate_id, assessment_id], map: "uq_cid_aid")
}

model company_details {
  company_id          Int              @id(map: "company_name_pkey") @default(autoincrement())
  company_description String?
  company_name        String?          @unique(map: "company_company_name_key") @db.VarChar(255)
  created_at          DateTime?        @db.Timestamp(6)
  updated_at          DateTime?        @db.Timestamp(6)
  center_company      center_company[]
  course_details      course_details[]
}

enum attend_types {
  present
  late
  absent
}
