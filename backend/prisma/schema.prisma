generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model candidates_details {
  candidate_id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_first_name           String                 @db.VarChar(100)
  candidate_last_name            String?                @db.VarChar(50)
  contact_number                 String                 @unique @db.VarChar(10)
  gender                         String?                @db.VarChar(10)
  date_of_birth                  DateTime?              @db.Date
  education                      String?                @db.VarChar(100)
  candidate_current_address      String?
  enquiry_source                 String?                @db.VarChar(50)
  aadhar_card_no                 String?                @db.VarChar(12)
  pan_card_no                    String?                @db.VarChar(10)
  guardian_name                  String?                @db.VarChar(50)
  nearest_station                String?                @db.VarChar(50)
  salary                         Int?
  training_start_date            DateTime?              @db.Date
  training_end_date              DateTime?              @db.Date
  job_location                   String?                @db.VarChar(100)
  candidate_status               String?                @db.VarChar(50)
  verification_status            String?                @db.VarChar(50)
  blood_group                    String?                @db.VarChar(5)
  category                       String?                @db.VarChar(15)
  user_id                        String                 @unique(map: "uq_candidate_user") @db.Uuid
  created_at                     DateTime               @default(now()) @db.Timestamp(6)
  updated_at                     DateTime               @default(now()) @db.Timestamp(6)
  highest_qualification          String?                @db.VarChar(100)
  qualification_percentage       Decimal?               @db.Decimal(5, 2)
  admin_approval                 Boolean?
  candidate_skills               String[]
  guardian_phone_no              String?                @unique @db.VarChar(10)
  guardian_blood_group           String?                @db.VarChar(10)
  guardian_relationship          String?
  guardian_occupation            String?
  candidate_unique_id            String?                @unique
  guardian_address               String?
  guardian_gender                String?                @db.VarChar(10)
  guardian_dob                   DateTime?              @db.Date
  father_name                    String?
  father_occupation              String?
  father_phone_no                String?                @db.VarChar(10)
  father_blood_group             String?                @db.VarChar(10)
  mother_name                    String?
  mother_occupation              String?
  mother_blood_group             String?                @db.VarChar(10)
  mother_phone_no                String?                @db.VarChar(10)
  father_address                 String?
  mother_address                 String?
  profile_photo                  String?
  current_city                   String?
  current_district               String?                @db.VarChar(50)
  current_pin_code               String?
  current_state_name             String?                @db.VarChar(50)
  permanent_city                 String?
  permanent_pin_code             String?
  permanent_state_name           String?
  permanent_district             String?
  candidate_permanent_address    String?
  candidate_emergency_contact_no String?
  attendance_records             attendance_records[]
  batch_enrollment               batch_enrollment[]
  candidate_assessment           candidate_assessment[]
  candidate_documents            candidate_documents?
  user_login                     user_login             @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_candidate_user")
}

model attendance_records {
  attendance_id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id          String              @db.Uuid
  attendance_status     attend_types
  remarks               String?
  created_at            DateTime            @default(now()) @db.Timestamp(6)
  updated_at            DateTime            @default(now()) @db.Timestamp(6)
  attendance_session_id String              @db.Uuid
  time_in               DateTime?           @db.Timestamp(6)
  time_out              DateTime?           @db.Timestamp(6)
  candidates_details    candidates_details  @relation(fields: [candidate_id], references: [candidate_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_record_candidate")
  attendance_sessions   attendance_sessions @relation(fields: [attendance_session_id], references: [attendance_session_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_record_session")

  @@unique([attendance_session_id, candidate_id], map: "uq_session_candidate")
}

model batch_details {
  batch_id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_name          String                @db.VarChar(100)
  batch_code          String                @unique @db.VarChar(255)
  batch_desc          String
  course_id           String                @db.Uuid
  batch_start_date    DateTime              @db.Date
  batch_end_date      DateTime              @db.Date
  max_candidates      Int
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  instructor_id       String                @db.Uuid
  batch_type          training_type
  b_status            batch_status
  center_id           String?               @db.Uuid
  assessments         assessments[]
  attendance_sessions attendance_sessions[]
  center_details      center_details?       @relation(fields: [center_id], references: [center_id], onDelete: NoAction, onUpdate: NoAction)
  instructor          instructor_details    @relation(fields: [instructor_id], references: [instructor_id], onDelete: SetNull)
  course_details      course_details        @relation(fields: [course_id], references: [course_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_batch_course")
  batch_enrollment    batch_enrollment[]
  batch_syllabus      batch_syllabus[]
  event_batches       event_batches[]
  study_material      study_material[]
}

model course_details {
  course_id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_name     String            @db.VarChar(100)
  course_desc     String
  course_duration String            @db.VarChar(100)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @db.Timestamp(6)
  company_id      String            @db.Uuid
  course_mode     course_type
  batch_details   batch_details[]
  company_details company_details   @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_course_company")
  enquiry_records enquiry_records[]
}

model center_company {
  center_id       String          @db.Uuid
  company_id      String          @db.Uuid
  created_at      DateTime        @default(now()) @db.Timestamp(6)
  updated_at      DateTime        @default(now()) @db.Timestamp(6)
  center_details  center_details  @relation(fields: [center_id], references: [center_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_center_company_center")
  company_details company_details @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_center_company_company")

  @@id([center_id, company_id])
}

model center_details {
  center_id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_name     String            @unique @db.VarChar(255)
  center_address  String
  center_email    String            @unique @db.VarChar(255)
  center_contact  String            @db.VarChar(15)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @db.Timestamp(6)
  center_code     String?           @unique(map: "center_details_center_code_unique") @db.VarChar(6)
  batch_details   batch_details[]
  center_company  center_company[]
  enquiry_records enquiry_records[]
  event_details   event_details[]
  user_login      user_login[]
}

model enquiry_records {
  enquiry_id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiry_first_name     String                   @db.VarChar(100)
  enquiry_last_name      String?                  @db.VarChar(100)
  enquiry_email          String                   @db.VarChar(255)
  enquiry_phone_no       String                   @db.VarChar(15)
  enquiry_education      String?                  @db.VarChar(100)
  enquiry_location       String?
  course_id              String?                  @db.Uuid
  enquiry_source         String?                  @db.VarChar(100)
  remarks                String?
  created_at             DateTime                 @default(now()) @db.Timestamp(6)
  updated_at             DateTime                 @default(now()) @db.Timestamp(6)
  enq_status             enquiry_status?
  center_id              String                   @db.Uuid
  mobilizer_id           String?                  @db.Uuid
  course_details         course_details?          @relation(fields: [course_id], references: [course_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enquiry_course")
  center_details         center_details           @relation(fields: [center_id], references: [center_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enquiry_records_center")
  mobilizer_details      mobilizer_details?       @relation(fields: [mobilizer_id], references: [mobilizer_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enquiry_records_mobilizer")
  enquiry_status_history enquiry_status_history[]
}

model user_login {
  user_id                                            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_email                                         String               @unique @db.VarChar(255)
  user_password                                      String
  user_role                                          role_types
  created_at                                         DateTime             @default(now()) @db.Timestamp(6)
  updated_at                                         DateTime             @default(now()) @db.Timestamp(6)
  center_id                                          String               @db.Uuid
  refresh_token_hash                                 String?
  is_active                                          Boolean              @default(true)
  admin_details                                      admin_details?
  candidates_details                                 candidates_details?
  event_details_event_details_created_byTouser_login event_details[]      @relation("event_details_created_byTouser_login")
  event_details_event_details_updated_byTouser_login event_details[]      @relation("event_details_updated_byTouser_login")
  hr_details                                         hr_details?
  instructor_details                                 instructor_details?
  mobilizer_details                                  mobilizer_details?
  study_material                                     study_material[]
  center_details                                     center_details       @relation(fields: [center_id], references: [center_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_center")
  user_notifications                                 user_notifications[]
}

model assessments {
  assessment_id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id             String                 @db.Uuid
  title                String                 @db.VarChar(255)
  assessment_desc      String?
  assessment_type      assessment_type
  assessment_date      DateTime               @db.Date
  created_at           DateTime               @default(now()) @db.Timestamp(6)
  updated_at           DateTime               @default(now()) @db.Timestamp(6)
  questions            Int?
  is_show              Boolean?               @default(true)
  assessment_link      String?
  assessment_duration  Int?
  batch_details        batch_details          @relation(fields: [batch_id], references: [batch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assessment_batch")
  candidate_assessment candidate_assessment[]
}

model company_details {
  company_id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_name        String               @unique @db.VarChar(255)
  company_description String?
  created_at          DateTime             @default(now()) @db.Timestamp(6)
  updated_at          DateTime             @default(now()) @db.Timestamp(6)
  center_company      center_company[]
  course_details      course_details[]
  hr_details          hr_details[]
  instructor_details  instructor_details[]
}

model instructor_details {
  instructor_id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                          String                @unique @db.Uuid
  instructor_first_name            String                @db.VarChar(100)
  instructor_last_name             String?               @db.VarChar(100)
  contact_number                   String                @unique @db.VarChar(10)
  gender                           String?               @db.VarChar(10)
  date_of_birth                    DateTime?             @db.Date
  specialization                   String?               @db.VarChar(255)
  experience_years                 Int?
  instructor_status                String?               @db.VarChar(50)
  created_at                       DateTime              @default(now()) @db.Timestamp(6)
  updated_at                       DateTime              @default(now()) @db.Timestamp(6)
  company_id                       String                @db.Uuid
  instructor_state                 String?               @db.VarChar(250)
  instructor_district              String?               @db.VarChar(250)
  instructor_taluka                String?               @db.VarChar(250)
  instructor_pin_code              String?               @db.VarChar(6)
  instructor_address               String?
  qualification                    String[]
  emergency_contact                String?               @db.VarChar(10)
  instructor_blood_group           String?               @db.VarChar(10)
  instructor_guardian_name         String?               @db.VarChar(255)
  instructor_guardian_relationship String?               @db.VarChar(255)
  instructor_guardian_occupation   String?               @db.VarChar(255)
  instructor_guardian_address      String?
  instructor_guardian_contact_no   String?               @db.VarChar(10)
  instructor_university            String?
  instructor_passing_year          String?               @db.VarChar(10)
  instructor_certificates          String[]
  instructor_prev_org              String?
  instructor_prev_org_designation  String?               @db.VarChar(255)
  highest_qualification            String?               @db.VarChar(255)
  father_name                      String?
  father_occupation                String?
  father_phone_no                  String?               @db.VarChar(10)
  father_blood_group               String?               @db.VarChar(10)
  mother_name                      String?
  mother_occupation                String?
  mother_blood_group               String?               @db.VarChar(10)
  mother_phone_no                  String?               @db.VarChar(10)
  father_current_address           String?
  mother_current_address           String?
  guardian_dob                     DateTime?             @db.Date
  father_dob                       DateTime?             @db.Date
  mother_dob                       DateTime?             @db.Date
  current_city                     String?
  current_state                    String?
  current_district                 String?
  current_taluka                   String?
  current_pincode                  String?               @db.VarChar(6)
  current_address                  String?
  profile_photo                    String?
  instructor_guardian_blood_group  String?               @db.VarChar(6)
  permanent_address                String?
  permanent_city                   String?
  permanent_district               String?
  permanent_pincode                String?               @db.VarChar(6)
  permanent_state                  String?
  permanent_taluka                 String?
  instructor_unique_id             String                @unique(map: "uq_instructor_unique_id")
  instructor_designation           String?
  attendance_sessions              attendance_sessions[]
  batches                          batch_details[]
  batch_syllabus                   batch_syllabus[]
  company_details                  company_details       @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_instructor_company")
  user_login                       user_login            @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_instructor_user")
  instructor_documents             instructor_documents?
}

model batch_enrollment {
  enrollment_id      String                        @id(map: "course_enrollment_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id       String                        @db.Uuid
  batch_id           String                        @db.Uuid
  enrollment_date    DateTime                      @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at         DateTime                      @default(now()) @db.Timestamp(6)
  updated_at         DateTime                      @default(now()) @db.Timestamp(6)
  grade              grade_types?
  certificate_url    String?                       @unique
  enrollment_status  batch_enrollment_status_type?
  candidate_batch_id String?                       @unique @db.VarChar(255)
  batch_details      batch_details                 @relation(fields: [batch_id], references: [batch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enrollment_batch")
  candidates_details candidates_details            @relation(fields: [candidate_id], references: [candidate_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enrollment_candidate")

  @@unique([candidate_id, batch_id], map: "uq_candidate_batch")
}

model attendance_sessions {
  attendance_session_id String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id              String               @db.Uuid
  instructor_id         String               @db.Uuid
  session_date          DateTime             @db.Date
  attendance_mode       attendance_mode_type
  created_at            DateTime             @default(now()) @db.Timestamp(6)
  updated_at            DateTime             @default(now()) @db.Timestamp(6)
  session_time          DateTime?            @db.Time(6)
  room_no               String?              @db.VarChar(100)
  topic_name            String?
  attendance_records    attendance_records[]
  batch_details         batch_details        @relation(fields: [batch_id], references: [batch_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_session_batch")
  instructor_details    instructor_details   @relation(fields: [instructor_id], references: [instructor_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_session_instructor")

  @@unique([batch_id, session_date], map: "uq_batch_session")
}

model candidate_documents {
  document_id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id          String             @unique(map: "uq_candidate_documents_candidate") @db.Uuid
  candidate_photo       String?
  candidate_aadhar_card String?
  candidate_pan_card    String?
  candidate_resume      String?
  candidates_details    candidates_details @relation(fields: [candidate_id], references: [candidate_id], onDelete: NoAction, onUpdate: NoAction)
}

model candidate_assessment {
  ca_record_id       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessment_id      String             @db.Uuid
  candidate_id       String             @db.Uuid
  attempted_at       DateTime           @default(now()) @db.Timestamp(6)
  assessment_grade   grade_types?
  created_at         DateTime           @default(now()) @db.Timestamp(6)
  updated_at         DateTime           @default(now()) @db.Timestamp(6)
  assessments        assessments        @relation(fields: [assessment_id], references: [assessment_id], onDelete: NoAction, onUpdate: NoAction)
  candidates_details candidates_details @relation(fields: [candidate_id], references: [candidate_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assessment_id, candidate_id])
}

model instructor_documents {
  instructor_doc_id                          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instructor_id                              String?             @unique @db.Uuid
  past_exp_letter                            String?
  pan_card                                   String?
  aadhar_card                                String?
  instructor_resume                          String?
  created_at                                 DateTime?           @default(now()) @db.Timestamp(6)
  updated_at                                 DateTime?           @default(now()) @db.Timestamp(6)
  instructor_highest_qualification_documents String?
  instructor_details                         instructor_details? @relation(fields: [instructor_id], references: [instructor_id], onDelete: NoAction, onUpdate: NoAction)
}

model notifications {
  notification_id      String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                String
  notification_message String
  notification_type    notification_type
  reference_type       notification_reference_type?
  reference_id         String?                      @db.Uuid
  created_at           DateTime?                    @default(now()) @db.Timestamp(6)
  updated_at           DateTime                     @default(now()) @updatedAt @db.Timestamp(6)
  user_                user_notifications[]
}

model study_material {
  study_material_id String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id          String        @db.Uuid
  uploaded_by       String        @db.Uuid
  title             String
  description       String?
  document_link     String
  is_show           Boolean       @default(true)
  created_at        DateTime?     @default(now()) @db.Timestamp(6)
  updated_at        DateTime?     @default(now()) @db.Timestamp(6)
  batch_details     batch_details @relation(fields: [batch_id], references: [batch_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_study_material_batch")
  user_login        user_login    @relation(fields: [uploaded_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_study_material_uploaded_by")
}

model user_notifications {
  user_notification_id String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notification_id      String        @db.Uuid
  user_id              String        @db.Uuid
  is_read              Boolean       @default(false)
  read_at              DateTime?     @db.Timestamp(6)
  created_at           DateTime      @default(now()) @db.Timestamp(6)
  notifications        notifications @relation(fields: [notification_id], references: [notification_id], onDelete: Cascade, onUpdate: NoAction)
  user_login           user_login    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([notification_id, user_id], map: "unique_notification_per_user")
}

model event_batches {
  event_batch_id String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id       String        @db.Uuid
  batch_id       String        @db.Uuid
  batch_details  batch_details @relation(fields: [batch_id], references: [batch_id], onDelete: Cascade, onUpdate: NoAction)
  event_details  event_details @relation(fields: [event_id], references: [event_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_id, batch_id])
}

model event_details {
  event_id                                        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id                                       String?            @db.Uuid
  event_title                                     String             @db.VarChar(255)
  event_description                               String?
  event_date                                      DateTime           @db.Date
  event_time                                      DateTime           @db.Time(6)
  venue                                           String?            @db.VarChar(255)
  is_show                                         Boolean?           @default(true)
  created_by                                      String             @db.Uuid
  created_at                                      DateTime?          @default(now()) @db.Timestamp(6)
  updated_at                                      DateTime           @default(now()) @updatedAt @db.Timestamp(6)
  updated_by                                      String             @db.Uuid
  event_link                                      String?
  event_mode                                      event_mode?
  event_type                                      event_type?
  target_type                                     event_target_type?
  event_status                                    event_status_type?
  event_documents                                 String[]
  event_batches                                   event_batches[]
  center_details                                  center_details?    @relation(fields: [center_id], references: [center_id], onDelete: Cascade, onUpdate: NoAction)
  user_login_event_details_created_byTouser_login user_login         @relation("event_details_created_byTouser_login", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  user_login_event_details_updated_byTouser_login user_login         @relation("event_details_updated_byTouser_login", fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model admin_details {
  admin_id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_first_name      String
  admin_last_name       String?
  blood_group           String?           @db.VarChar(5)
  date_of_birth         DateTime?         @db.Date
  highest_qualification String?
  specialization        String?
  university            String?
  passing_year          Int?
  total_experience      Decimal?          @db.Decimal(5, 2)
  prev_organization     String?
  prev_org_role         String?
  father_name           String?
  father_mobile_no      String?           @db.VarChar(10)
  father_address        String?
  father_occupation     String?
  father_blood_group    String?           @db.VarChar(5)
  father_dob            DateTime?         @db.Date
  mother_name           String?
  mother_mobile_no      String?           @db.VarChar(10)
  mother_address        String?
  mother_occupation     String?
  mother_blood_group    String?           @db.VarChar(5)
  mother_dob            DateTime?         @db.Date
  guardian_name         String?
  guardian_dob          DateTime?         @db.Date
  guardian_address      String?
  guardian_gender       String?           @db.VarChar(20)
  guardian_blood_group  String?           @db.VarChar(5)
  guardian_phone_number String?           @db.VarChar(10)
  user_id               String            @unique @db.Uuid
  admin_phone_no        String?           @db.VarChar(10)
  user_login            user_login        @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_admin_details_user")
  admin_documents       admin_documents[]
}

model admin_documents {
  admin_document_id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id                               String        @db.Uuid
  pan_card_link                          String?
  aadhar_card_link                       String?
  resume_link                            String?
  past_experience_letter_link            String?
  highest_qualification_certificate_link String?
  admin_details                          admin_details @relation(fields: [admin_id], references: [admin_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_admin_documents_admin")
}

model batch_syllabus {
  batch_syllabus_id  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id           String              @db.Uuid
  topic_name         String
  completion_date    DateTime            @db.Date
  is_completed       Boolean             @default(false)
  completed_at       DateTime?           @db.Timestamp(6)
  completed_by       String?             @db.Uuid
  created_at         DateTime            @default(now()) @db.Timestamp(6)
  updated_at         DateTime            @default(now()) @db.Timestamp(6)
  batch_details      batch_details       @relation(fields: [batch_id], references: [batch_id], onDelete: NoAction, onUpdate: NoAction)
  instructor_details instructor_details? @relation(fields: [completed_by], references: [instructor_id], onDelete: NoAction, onUpdate: NoAction)
}

model enquiry_status_history {
  history_id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiry_id        String            @db.Uuid
  mobilizer_id      String            @db.Uuid
  created_at        DateTime          @default(now()) @db.Timestamp(6)
  updated_at        DateTime          @default(now()) @db.Timestamp(6)
  enq_status        enquiry_status?
  enquiry_records   enquiry_records   @relation(fields: [enquiry_id], references: [enquiry_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enquiry_status_history_enquiry")
  mobilizer_details mobilizer_details @relation(fields: [mobilizer_id], references: [mobilizer_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enquiry_status_history_mobilizer")
}

model hr_details {
  hr_id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hr_first_name   String
  hr_last_name    String?
  hr_designation  String
  hr_phone_no     String          @unique(map: "uq_hr_phone_no") @db.VarChar(10)
  company_id      String          @db.Uuid
  user_id         String          @unique @db.Uuid
  hr_unique_id    String?         @unique(map: "uq_hr_unique_id")
  created_at      DateTime        @default(now()) @db.Timestamp(6)
  updated_at      DateTime        @default(now()) @db.Timestamp(6)
  company_details company_details @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_hr_details_company")
  user_login      user_login      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_hr_details_user")
  job_events      job_events[]
  placement       placement[]
}

model mobilizer_details {
  mobilizer_id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mobilizer_phone_no     String?                  @unique @db.VarChar(10)
  mobilizer_unique_id    String?                  @unique
  user_id                String                   @unique @db.Uuid
  mobilizer_first_name   String
  mobilizer_last_name    String
  mobilizer_designation  String?
  enquiry_records        enquiry_records[]
  enquiry_status_history enquiry_status_history[]
  user_login             user_login               @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model job_events {
  job_event_id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type          job_event_type
  event_name          String                @db.VarChar(255)
  event_date          DateTime              @db.Date
  event_start_time    DateTime?              @db.Time(6)
  event_end_time      DateTime?              @db.Time(6)
  address             String
  google_map_link     String?
  description         String?
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  created_by          String                @db.Uuid
  jobevent_photos     String[]              @default([])
  event_status        job_event_status      @default(UPCOMING)
  hr_details          hr_details            @relation(fields: [created_by], references: [hr_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_job_events_created_by")
  job_fair_candidates job_fair_candidates[]
}

model placement {
  placement_id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_name             String                   @db.VarChar(255)
  vacancy                  Int
  location                 String                   @db.VarChar(255)
  job_role                 String                   @db.VarChar(255)
  job_description          String?
  last_date_to_apply       DateTime                 @db.Date
  is_active                Boolean?                 @default(true)
  created_at               DateTime?                @default(now()) @db.Timestamp(6)
  updated_at               DateTime?                @default(now()) @db.Timestamp(6)
  created_by               String                   @db.Uuid
  work_mode                work_mode_type?
  eligible_qualification   String?
  eligible_percentage_cgpa String?
  employment_type          String?
  sector                   String?
  experience               String?
  salary_min               Int?
  salary_max               Int?
  hr_details               hr_details               @relation(fields: [created_by], references: [hr_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_placement_created_by")
  placement_applications   placement_applications[]

  @@index([company_name(ops: raw("gin_trgm_ops"))], map: "idx_placement_company_name_trgm", type: Gin)
  @@index([job_role(ops: raw("gin_trgm_ops"))], map: "idx_placement_job_role_trgm", type: Gin)
  @@index([location(ops: raw("gin_trgm_ops"))], map: "idx_placement_location_trgm", type: Gin)
  @@index([salary_min, salary_max], map: "idx_placement_salary_range")
  @@index([sector(ops: raw("gin_trgm_ops"))], map: "idx_placement_sector_trgm", type: Gin)
  @@index([work_mode], map: "idx_placement_work_mode")
}

model placement_applications {
  application_id     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placement_id       String                  @db.Uuid
  applicant_name     String                  @db.VarChar(255)
  email              String                  @db.VarChar(255)
  contact_no         String                  @db.VarChar(20)
  applied_date       DateTime                @default(dbgenerated("CURRENT_DATE")) @db.Date
  resume             String
  source             String?                 @db.VarChar(100)
  application_status application_status_type @default(SCREENING)
  created_at         DateTime?               @default(now()) @db.Timestamp(6)
  updated_at         DateTime?               @default(now()) @db.Timestamp(6)
  placement          placement               @relation(fields: [placement_id], references: [placement_id], onDelete: Cascade, map: "fk_placement_application_placement")

  @@unique([placement_id, email], map: "unique_placement_applicant_email")
}

model job_fair_candidates {
  job_fair_candidate_id        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_event_id                 String                   @db.Uuid
  candidate_name               String                   @db.VarChar(255)
  contact_no                   String                   @db.VarChar(15)
  location                     String?                  @db.VarChar(255)
  qualification                String?                  @db.VarChar(255)
  college_institute            String?                  @db.VarChar(255)
  age                          Int?
  gender                       String?                  @db.VarChar(50)
  candidate_experience         String?                  @db.VarChar(50)
  area                         String?                  @db.VarChar(255)
  ward_no                      String?                  @db.VarChar(50)
  vidhansabha                  String?                  @db.VarChar(255)
  company_name                 String?                  @db.VarChar(255)
  created_at                   DateTime?                @default(now()) @db.Timestamp(6)
  updated_at                   DateTime?                @default(now()) @db.Timestamp(6)
  candidate_application_status application_status_type?
  job_events                   job_events               @relation(fields: [job_event_id], references: [job_event_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_job_fair_candidates_job_event")
}

